{
  "name": "fox-renard",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "size": "pnpm --filter @fox-renard/widget size",
    "e2e": "pnpm --filter @fox-renard/demo e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:"
  }
}
